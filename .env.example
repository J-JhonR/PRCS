DEBUG=False
SECRET_KEY=change-me-generate-with-get_random_secret_key
ALLOWED_HOSTS=your-domain.com

DB_NAME=portail_recrutement
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306
# A activer pour une base MySQL geree (Aiven, TiDB Cloud...) qui exige TLS
DB_SSL_REQUIRED=False
DB_SSL_CA=

CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com
# "None" est obligatoire si le frontend et le backend sont sur des domaines
# differents (ex: Vercel + Render) ; laisser "Lax" en local
COOKIE_SAMESITE=Lax

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@your-domain.com

FRONTEND_URL=https://your-frontend-domain.com
